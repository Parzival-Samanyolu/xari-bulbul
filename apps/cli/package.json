{
  "name": "xari-bulbul-cli",
  "version": "0.2.3",
  "description": "xb — Xarı Bülbül in your terminal: an open coding agent for any model",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Parzival-Samanyolu/xari-bulbul.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "xb": "dist/xb.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
