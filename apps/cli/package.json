    "esbuild": "^0.28.2",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
